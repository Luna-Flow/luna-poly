name = "Luna-Flow/luna-poly"

version = "0.3.0"

import {
  "Luna-Flow/arithmetic@0.5.0",
  "Luna-Flow/luna-generic@0.4.0",
  "moonbitlang/quickcheck@0.14.0",
  "Luna-Flow/type_theory@0.2.0",
}

readme = "README.md"

repository = "https://github.com/Luna-Flow/luna-poly"

license = "Apache-2.0"

keywords = [ "polynomial", "symbolic-methods", "numerical-methods", "math" ]

description = "Immutable and mutable polynomial libraries for MoonBit with canonical dense, sparse, and context-aware representations."

source = "src"
